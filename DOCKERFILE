# syntax=docker/dockerfile:1.7

FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS frontend-build

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    LOCAL_LLM_HOST=0.0.0.0 \
    LOCAL_LLM_LOG_FILE=/home/llm/local_isolated_llm.log \
    HOME=/home/llm \
    HF_HOME=/home/llm/.cache/huggingface

RUN adduser --disabled-password --gecos "" --uid 10001 llm \
    && mkdir -p /home/llm/.cache/huggingface \
    && chown -R llm:llm /home/llm

COPY pyproject.toml README.md ./
COPY app ./app
COPY user_config.yaml ./user_config.yaml
COPY llm_server.py ./llm_server.py
RUN --mount=type=cache,target=/home/llm/.cache/pip pip install .
COPY --from=frontend-build /frontend/dist ./frontend/dist

USER llm
VOLUME ["/home/llm/.cache/huggingface"]
EXPOSE 8080
HEALTHCHECK --start-period=10m --interval=30s --timeout=5s --retries=3 CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health/ready' % os.getenv('LOCAL_LLM_PORT', '8080'), timeout=4)"]
CMD ["python", "llm_server.py"]
