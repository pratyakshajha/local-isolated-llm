# syntax=docker/dockerfile:1.7

FROM node:26-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797 AS frontend-build

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:13.0.0-cudnn-runtime-ubuntu22.04

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    LOCAL_LLM_HOST=0.0.0.0 \
    LOCAL_LLM_LOG_FILE=/home/llm/local_isolated_llm.log \
    HOME=/home/llm \
    HF_HOME=/home/llm/.cache/huggingface \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    software-properties-common \
    dirmngr gnupg gnupg-l10n gnupg-utils gnupg2 gpg gpg-agent gpg-wks-client gpg-wks-server gpgconf gpgsm gpgv \
    libssl3 openssl \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3.11 python3.11-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3.11 -m venv /opt/venv \
    && adduser --disabled-password --gecos "" --uid 10001 llm \
    && mkdir -p /home/llm/.cache/huggingface \
    && chown -R llm:llm /home/llm
ENV PATH="/opt/venv/bin:${PATH}"

COPY pyproject.toml README.md ./
COPY app ./app
COPY user_config.yaml ./user_config.yaml
COPY llm_server.py ./llm_server.py
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip==25.3 setuptools==84.2.1 \
    && python3 -m pip install . --extra-index-url https://download.pytorch.org/whl/cu130 \
    && python3 -c "import torch, uvicorn; assert torch.version.cuda == '13.0'" \
    && chown -R llm:llm /app
COPY --from=frontend-build /frontend/dist ./frontend/dist

USER llm
VOLUME ["/home/llm/.cache/huggingface"]
EXPOSE 8080
HEALTHCHECK --start-period=10m --interval=30s --timeout=5s --retries=3 CMD ["python3", "-c", "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/health/ready' % os.getenv('LOCAL_LLM_PORT', '8080'), timeout=4)"]
CMD ["python3", "llm_server.py"]
